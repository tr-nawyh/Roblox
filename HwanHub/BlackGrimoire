	alignPosition.Attachment0 = rootAttachment
	alignPosition.Attachment1 = targetAttachment
	alignPosition.ApplyAtCenterOfMass = true
	alignPosition.MaxForce = math.huge
	alignPosition.MaxVelocity = MOB_FLY_SPEED
	alignPosition.Responsiveness = MOB_RESPONSIVENESS
	alignPosition.RigidityEnabled = false
	alignPosition.ReactionForceEnabled = false
	alignPosition.Enabled = true
	alignPosition.Parent = rootPart
	local alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Name = "__HWAN_ChestAlignOrientation"
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = rootAttachment
	alignOrientation.MaxTorque = math.huge
	alignOrientation.Responsiveness = MOB_RESPONSIVENESS
	alignOrientation.RigidityEnabled = false
	alignOrientation.ReactionTorqueEnabled = false
	alignOrientation.Enabled = true
	alignOrientation.CFrame = rootPart.CFrame
	alignOrientation.Parent = rootPart
	chestControl.TargetPart = targetPart
	chestControl.RootAttachment = rootAttachment
	chestControl.TargetAttachment = targetAttachment
