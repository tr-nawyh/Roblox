local function isPointInsideGuiObject(guiObject, point)
	if not guiObject or not guiObject.Visible then return false end
	local pos = guiObject.AbsolutePosition
	local size = guiObject.AbsoluteSize
	return point.X >= pos.X and point.X <= pos.X + size.X and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end

local function isPointInsideAnyDropdown(point)
	for _, dropdownData in ipairs(DROPDOWNS) do
		if dropdownData.List.Visible and isPointInsideGuiObject(dropdownData.List, point) then
