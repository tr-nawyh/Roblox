updateChestMotion = function()
	if not runtimeAlive or not autoChestEnabled then return end
	local character = player.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return end
	if not chestControl.AlignPosition or not chestControl.AlignPosition.Parent or not chestControl.AlignOrientation or not chestControl.AlignOrientation.Parent or not chestControl.TargetPart or not chestControl.TargetPart.Parent then
		if not createChestMotion() then return end
	end
	local chests = getChests()
	if #chests == 0 then
		autoChestEnabled = false
		destroyChestMotion()
		setToggle(UI.autoChestToggle, false)
		UI.autoChestToggle.Description.Text = "No chests"
		releaseNoClip()
		return
	end
	local targetChest = getNearestChest()
	if not targetChest then
		autoChestEnabled = false
		destroyChestMotion()
		setToggle(UI.autoChestToggle, false)
		UI.autoChestToggle.Description.Text = "No chests"
		releaseNoClip()
		return
	end
	local chestPos
	if targetChest:IsA("BasePart") then
		chestPos = targetChest.Position
	else
		local ok, pivot = pcall(function() return targetChest:GetPivot() end)
		if ok then chestPos = pivot.Position end
	end
	if not chestPos then return end
	local distance = (rootPart.Position - chestPos).Magnitude
	if distance < 5 then
		chestControl.TargetPart.CFrame = rootPart.CFrame
		chestControl.AlignOrientation.CFrame = rootPart.CFrame
	else
		chestControl.TargetPart.CFrame = CFrame.new(chestPos)
		chestControl.AlignPosition.MaxVelocity = MOB_FLY_SPEED
		chestControl.AlignPosition.Responsiveness = MOB_RESPONSIVENESS
		chestControl.AlignOrientation.Responsiveness = MOB_RESPONSIVENESS
		chestControl.AlignOrientation.CFrame = CFrame.lookAt(rootPart.Position, chestPos)
	end
	UI.autoChestToggle.Description.Text = formatChestCount(#chests)
end
