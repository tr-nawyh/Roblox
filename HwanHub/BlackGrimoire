		if os.clock() >= flightCourseWaitUntil and not flightCourseReceiveLock then
			flightCourseReceiveLock = true
			local generation = flightCourseGeneration
			local questGenerationAtStart = questGeneration
			local function receiveFlightQuest()
				if not runtimeAlive or not autoFlightCourseEnabled or flightCourseGeneration ~= generation or questGeneration ~= questGenerationAtStart then
					if flightCourseGeneration == generation then flightCourseReceiveLock = false end
					return
				end
				local args = {"changeLightingToC", {Extra = "FlightCourse", Type = "questpls", NpcName = "ahmedBOOM234"}}
				local ok = fireMainRemote(unpack(args))
				if flightCourseGeneration ~= generation then return end
				flightCourseReceiveLock = false
				if not ok then
					flightCourseWaitUntil = os.clock() + 0.75
					return
				end
				questSwitching = false
				unquesting = false
				flightCourseStage = "post_receive_wait"
				flightCourseWaitUntil = os.clock() + 0.5
				flightCoursePointIndex = 1
			end
			runAfterQuestCancelled(questGenerationAtStart, receiveFlightQuest)
		end
	elseif flightCourseStage == "post_receive_wait" then
		targetCFrame = FLIGHT_COURSE_START_POSITION
		if os.clock() >= flightCourseWaitUntil then
			flightCourseStage = "points"
			flightCoursePointIndex = 1
		end
	elseif flightCourseStage == "points" then
		if flightCoursePointIndex <= #FLIGHT_COURSE_POINTS then
			targetCFrame = FLIGHT_COURSE_POINTS[flightCoursePointIndex]
		else
			flightCourseStage = "returning"
			targetCFrame = FLIGHT_COURSE_START_POSITION
		end
	elseif flightCourseStage == "returning" then
		targetCFrame = FLIGHT_COURSE_START_POSITION
		if (rootPart.Position - targetCFrame.Position).Magnitude < 5 then
			flightCourseStage = "waiting"
			flightCourseWaitUntil = os.clock() + 0.5
		end
	end
	if not targetCFrame then return end
	flightCourseControl.TargetPart.CFrame = targetCFrame
	flightCourseControl.AlignPosition.MaxVelocity = FLIGHT_COURSE_SPEED
	flightCourseControl.AlignPosition.Responsiveness = MOB_RESPONSIVENESS
	flightCourseControl.AlignOrientation.Responsiveness = MOB_RESPONSIVENESS
	local distance = (rootPart.Position - targetCFrame.Position).Magnitude
	if distance > 0.01 then
		flightCourseControl.AlignOrientation.CFrame = CFrame.lookAt(rootPart.Position, targetCFrame.Position)
	else
		flightCourseControl.AlignOrientation.CFrame = targetCFrame
	end
	if distance < 5 then
		if flightCourseStage == "start" then
			flightCourseStage = "waiting"
			flightCourseWaitUntil = os.clock() + 0.5
		elseif flightCourseStage == "points" then
			flightCoursePointIndex += 1
			if flightCoursePointIndex > #FLIGHT_COURSE_POINTS then
				flightCourseStage = "returning"
			end
		end
	end
end
