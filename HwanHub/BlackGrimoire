	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return end
	if not mobControl.AlignPosition or not mobControl.AlignPosition.Parent or not mobControl.AlignOrientation or not mobControl.AlignOrientation.Parent or not mobControl.TargetPart or not mobControl.TargetPart.Parent then
		if not createMobMotion() then return end
	end
	local mobFolder = refreshMobFolderConnection()
	if not mobFolder then
		currentMobTarget = nil
		return
	end
	if not currentMobTarget or not currentMobTarget.Parent or currentMobTarget.Name ~= selectedMob or currentMobTarget.Parent ~= mobFolder then
		currentMobTarget = getNextMobTarget(selectedMob)
	end
	if not currentMobTarget then
		mobControl.TargetPart.CFrame = rootPart.CFrame
		return
	end
	local mobHumanoid = currentMobTarget:FindFirstChildOfClass("Humanoid")
	if mobHumanoid and mobHumanoid.Health <= 0 then
		currentMobTarget = getNextMobTarget(selectedMob)
		if not currentMobTarget then
			mobControl.TargetPart.CFrame = rootPart.CFrame
			return
		end
	end
	local mobPivot = getMobPivot(currentMobTarget)
	if not mobPivot then
		currentMobTarget = getNextMobTarget(selectedMob)
		return
	end
	local offset
	if selectedAngle == "Above" then
		offset = Vector3.new(0, selectedDistance, 0)
	elseif selectedAngle == "Below" then
		offset = Vector3.new(0, -selectedDistance, 0)
	else
		offset = -mobPivot.LookVector * selectedDistance
	end
	local targetPosition = mobPivot.Position + offset
	mobControl.TargetPart.CFrame = CFrame.lookAt(targetPosition, mobPivot.Position)
	mobControl.AlignPosition.MaxVelocity = MOB_FLY_SPEED
	mobControl.AlignPosition.Responsiveness = MOB_RESPONSIVENESS
	mobControl.AlignOrientation.Responsiveness = MOB_RESPONSIVENESS
