local function recoverMissingWeapon(toolName)
	if not runtimeAlive or not toolName or toolName == "" then
		return
	end

	if weaponRecovery.Name ~= toolName then
		weaponRecovery.Name = toolName
		weaponRecovery.Attempts = 0
		weaponRecovery.InProgress = false
		weaponRecovery.Generation += 1
		weaponRecovery.LastResetAt = 0
	end

	if weaponRecovery.InProgress then
		return
	end

	local toolNow = findToolAnywhere(toolName)
	if toolNow then
		weaponRecovery.Attempts = 0
		if toolNow.Parent ~= player.Character then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				pcall(function()
					humanoid:EquipTool(toolNow)
				end)
			end
		end
		return
	end

	if not autoMobEnabled and not (autoQuestEnabled and selectedQuest and selectedQuest.MobName ~= nil) then
		return
	end

	if weaponRecovery.LastResetAt and os.clock() - weaponRecovery.LastResetAt < WEAPON_RESET_TIMEOUT then
		return
	end

	weaponRecovery.InProgress = true
	weaponRecovery.Attempts += 1
	weaponRecovery.LastResetAt = os.clock()
	local generation = weaponRecovery.Generation

	task.spawn(function()
		if not runtimeAlive or weaponRecovery.Generation ~= generation then
			weaponRecovery.InProgress = false
			return
		end

		if getAttackSkillName() ~= toolName then
			weaponRecovery.InProgress = false
			return
		end

		pcall(function()
			if resetCharacter then
				resetCharacter()
			end
		end)

		local deadline = os.clock() + WEAPON_RESET_TIMEOUT
		while runtimeAlive and os.clock() < deadline do
			if weaponRecovery.Generation ~= generation then
				weaponRecovery.InProgress = false
				return
			end

			if getAttackSkillName() ~= toolName then
				weaponRecovery.InProgress = false
				return
			end

			local tool = findToolAnywhere(toolName)
			if tool then
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if humanoid and tool.Parent ~= character then
					pcall(function()
						humanoid:EquipTool(tool)
					end)
				end
				weaponRecovery.Attempts = 0
				weaponRecovery.InProgress = false
				return
			end

			task.wait(0.1)
		end

		weaponRecovery.InProgress = false
	end)
end

