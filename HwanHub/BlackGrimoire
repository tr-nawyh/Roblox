local function positionDropdown(dropdownData)
	if not runtimeAlive then return end
	if not dropdownData.List.Visible then return end
	local button = dropdownData.Button
	local list = dropdownData.List
	local buttonPos = button.AbsolutePosition
	local buttonSize = button.AbsoluteSize
	local camera = workspace.CurrentCamera
	local viewportSize = camera and camera.ViewportSize or Vector2.new(800, 600)
	local listWidth = buttonSize.X
	local listHeight = 108
	local x = buttonPos.X
	local y = buttonPos.Y + buttonSize.Y + 6
	if x + listWidth > viewportSize.X - 6 then x = viewportSize.X - listWidth - 6 end
	if x < 6 then x = 6 end
	if y + listHeight > viewportSize.Y - 6 then
		local aboveY = buttonPos.Y - listHeight - 6
		if aboveY >= 6 then y = aboveY else y = math.max(6, viewportSize.Y - listHeight - 6) end
	end
	list.Size = UDim2.fromOffset(math.floor(listWidth), listHeight)
	list.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
end
