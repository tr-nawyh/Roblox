local function runAfterQuestCancelled(generation, callback)
	task.spawn(function()
		if not runtimeAlive or questGeneration ~= generation then return end
		questSwitching = true
		unquesting = true
		if not currentMissionIsEmpty() then
			pcall(unquest)
			local deadline = os.clock() + 2
			local retryAt = os.clock() + 0.35
			while runtimeAlive and questGeneration == generation and not currentMissionIsEmpty() and os.clock() < deadline do
				if os.clock() >= retryAt then
					pcall(unquest)
					retryAt = os.clock() + 0.5
				end
				task.wait(0.05)
			end
		end
		if not runtimeAlive or questGeneration ~= generation then return end
		if not currentMissionIsEmpty() then
			questSwitching = false
			unquesting = false
			questReceiveLock = false
			return
		end
		callback()
	end)
end
local function prepareAutoQuestFarm(generation, quest, alreadyCancelled)
	if not runtimeAlive or questGeneration ~= generation or not autoQuestEnabled or selectedQuest ~= quest then return end
	questNeedsSpawnReset = true
	questSpawnResetInProgress = true
	local function proceed()
		if not runtimeAlive or questGeneration ~= generation or not autoQuestEnabled or selectedQuest ~= quest then
			if questGeneration == generation then
				questSpawnResetInProgress = false
				questNeedsSpawnReset = false
				questSwitching = false
				unquesting = false
			end
			return
		end
		if quest.SetSpawn then pcall(quest.SetSpawn) end
		task.wait(0.5)
		if not runtimeAlive or questGeneration ~= generation or not autoQuestEnabled or selectedQuest ~= quest then
			if questGeneration == generation then
				questSpawnResetInProgress = false
				questNeedsSpawnReset = false
				questSwitching = false
				unquesting = false
			end
			return
		end
		pcall(resetCharacter)
		local deadline = os.clock() + 3
		while runtimeAlive and questGeneration == generation and autoQuestEnabled and selectedQuest == quest and (not player.Character or not player.Character:FindFirstChild("HumanoidRootPart")) and os.clock() < deadline do
			task.wait(0.05)
		end
		if not runtimeAlive or questGeneration ~= generation or not autoQuestEnabled or selectedQuest ~= quest then
			if questGeneration == generation then
				questSpawnResetInProgress = false
				questNeedsSpawnReset = false
			end
			return
		end
		questSpawnResetInProgress = false
		questNeedsSpawnReset = false
		unquesting = false
		questSwitching = false
		if quest.MobName then
			autoMobManagedByQuest = true
			selectedMob = quest.MobName
			UI.mobDropdown.SelectedValue = quest.MobName
			UI.mobDropdown.Button.Text = quest.MobName
			UI.autoMobToggle.Description.Text = quest.MobName
			autoMobEnabled = true
			setToggle(UI.autoMobToggle, true)
			refreshMobFolderConnection()
			currentMobTarget = getNextMobTarget(quest.MobName)
			if createMobMotion() then applyNoClip() end
		end
		task.defer(function()
			if runtimeAlive and questGeneration == generation and autoQuestEnabled and selectedQuest == quest then
				tryReceiveQuest()
			end
		end)
	end
	if alreadyCancelled then
		task.spawn(proceed)
	else
		runAfterQuestCancelled(generation, proceed)
	end
end
local function restartSelectedQuestMode(generation)
	if not runtimeAlive or questGeneration ~= generation then return end
	if autoQuestEnabled and selectedQuest then
		prepareAutoQuestFarm(generation, selectedQuest, true)
		return
	end
	if autoTrainBodyEnabled then
		trainBodyGeneration += 1
		trainBodyQuestLock = false
		requestTrainBodyQuest()
		return
	end
	if autoFlightCourseEnabled then
		flightCourseGeneration += 1
		flightCourseReceiveLock = false
		flightCourseStage = "start"
		flightCoursePointIndex = 1
		flightCourseWaitUntil = 0
		if createFlightCourseMotion() then applyNoClip() end
		return
	end
	finishQuestTransition(generation)
end
