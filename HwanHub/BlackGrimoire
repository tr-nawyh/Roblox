local runtimeAlive = true
local connections = {}
local function connect(signal, callback, bucket)
	if not signal or not signal.Connect then return nil end
	local connection = signal:Connect(function(...)
		if not runtimeAlive then return end
		pcall(callback, ...)
	end)
	table.insert(bucket or connections, connection)
	return connection
end
local function disconnectConnectionList(list)
	if not list then return end
	for i = #list, 1, -1 do
		local connection = list[i]
		pcall(function() if connection then connection:Disconnect() end end)
		list[i] = nil
	end
end
