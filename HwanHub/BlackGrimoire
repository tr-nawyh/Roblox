local function selectQuest(newQuest)
	if not newQuest then
		return;
	end
	if (selectedQuest and (selectedQuest.Name ~= newQuest.Name) and not currentMissionIsEmpty()) then
		questSwitching = true;
		questReceiveLock = false;
		pcall(unquest);
	end
	selectedQuest = newQuest;
	questDropdown.Button.Text = newQuest.Name;
	autoQuestToggle.Description.Text = newQuest.Name;
	questDropdown.SelectedValue = newQuest.Name;
	if (autoQuestEnabled and selectedQuest) then
		questNeedsSpawnReset = true;
		if autoMobEnabled then
			autoMobEnabled = false;
			currentMobTarget = nil;
			destroyMobMotion();
			setToggle(autoMobToggle, false);
			autoMobToggle.Description.Text = selectedMob or "Select a mob first";
		end
		if autoTrainBodyEnabled then
			autoTrainBodyEnabled = false;
			setToggle(autoTrainBodyToggle, false);
			autoTrainBodyToggle.Description.Text = "Train body automatically";
		end
		if autoChestEnabled then
			autoChestEnabled = false;
			destroyChestMotion();
			setToggle(autoChestToggle, false);
			autoChestToggle.Description.Text = "Chests: 0";
		end
		if selectedQuest.IsFlightCourse then
			autoFlightCourseEnabled = true;
		else
			autoFlightCourseEnabled = false;
		end
		task.spawn(function()
			if not runtimeAlive then
				return;
			end
			questSpawnResetInProgress = true;
			if selectedQuest.SetSpawn then
				pcall(selectedQuest.SetSpawn);
			end
			task.wait(0.5);
			resetCharacter();
			questSpawnResetInProgress = false;
			questNeedsSpawnReset = false;
		end);
	end
	task.defer(function()
		if not runtimeAlive then
			return;
		end
		local attempts = 0;
		while not currentMissionIsEmpty() and (attempts < 20) do
			attempts += 1
			task.wait(0.05);
		end
		questSwitching = false;
		if (autoQuestEnabled and not questNeedsSpawnReset) then
			tryReceiveQuest();
		end
	end);
end
