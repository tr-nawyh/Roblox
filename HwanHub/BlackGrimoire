function tryReceiveQuest()
	if not runtimeAlive then
		return;
	end
	if not autoQuestEnabled then
		return;
	end
	if not selectedQuest then
		return;
	end
	if questSwitching then
		return;
	end
	if questReceiveLock then
		return;
	end
	if (questNeedsSpawnReset or questSpawnResetInProgress) then
		return;
	end
	if selectedQuest.IsFlightCourse then
		return;
	end
	if not currentMissionIsEmpty() then
		return;
	end
	if unquesting then
		return;
	end
	questReceiveLock = true;
	pcall(function()
		selectedQuest.ReceiveQuest();
	end);
	task.delay(QUEST_RETRY_DELAY, function()
		if not runtimeAlive then
			return;
		end
		questReceiveLock = false;
		if (autoQuestEnabled and selectedQuest and not questSwitching and currentMissionIsEmpty() and not questNeedsSpawnReset and not selectedQuest.IsFlightCourse) then
			tryReceiveQuest();
		end
	end);
end
