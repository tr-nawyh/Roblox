connect(player.CharacterAdded, function()
	if not runtimeAlive then return end
	noClipState = {}
	noClipLastEnforce = 0
	currentMobTarget = nil
	mobGeneration += 1
	chestGeneration += 1
	flightCourseGeneration += 1
	pcall(function() if destroyMobMotion then destroyMobMotion() end end)
	pcall(function() if destroyFlightCourseMotion then destroyFlightCourseMotion() end end)
	pcall(function() if destroyChestMotion then destroyChestMotion() end end)
	if autoFlightCourseEnabled then
		local generation = flightCourseGeneration
		flightCourseStage = "start"
		flightCoursePointIndex = 1
		flightCourseWaitUntil = 0
		flightCourseReceiveLock = false
		task.delay(0.5, function()
			if runtimeAlive and autoFlightCourseEnabled and flightCourseGeneration == generation then
				if createFlightCourseMotion() then applyNoClip() end
			end
		end)
	end
	if autoQuestEnabled and selectedQuest then
		local generation = questGeneration
		local quest = selectedQuest
		local mobName = quest.MobName
		if mobName then
			autoMobManagedByQuest = true
			selectedMob = mobName
			UI.mobDropdown.SelectedValue = mobName
			UI.mobDropdown.Button.Text = mobName
			UI.autoMobToggle.Description.Text = mobName
			autoMobEnabled = true
			setToggle(UI.autoMobToggle, true)
			refreshMobFolderConnection()
			currentMobTarget = getNextMobTarget(mobName)
			if createMobMotion() then applyNoClip() end
			local generation = questGeneration
			task.delay(0.5, function()
				if runtimeAlive and autoQuestEnabled and questGeneration == generation and selectedQuest == quest and not questNeedsSpawnReset and not questSpawnResetInProgress and not questSwitching then
					tryReceiveQuest()
				end
			end)
		end
	end
	if autoMobEnabled and not (autoQuestEnabled and selectedQuest and selectedQuest.MobName) then
		local generation = mobGeneration
		task.delay(0.5, function()
			if runtimeAlive and autoMobEnabled and mobGeneration == generation then
				refreshMobFolderConnection()
				currentMobTarget = getNextMobTarget(selectedMob)
				if createMobMotion() then applyNoClip() end
			end
		end)
	end
	if autoChestEnabled then
		local generation = chestGeneration
		task.delay(0.5, function()
			if runtimeAlive and autoChestEnabled and chestGeneration == generation then
				if #getChests() > 0 then
					if createChestMotion() then applyNoClip() end
				else
					autoChestEnabled = false
					destroyChestMotion()
					setToggle(UI.autoChestToggle, false)
					UI.autoChestToggle.Description.Text = "No chests"
				end
			end
		end)
	end
	task.delay(0.35, function()
		if runtimeAlive then
			refreshSkillList()
			refreshMobList()
		end
	end)
end)
